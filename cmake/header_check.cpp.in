// Generated by snicholls-tooling's snicholls_header_check() for one header. The header must compile on its own and
// twice in one translation unit, behind its named guard, so a missing include or a broken or misnamed guard fails
// the build here rather than in a consumer.
#include <@HEADER@>
@GUARD_CHECK@
#include <@HEADER@>
